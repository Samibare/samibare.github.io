---
/** One page per write-up in src/content/research/. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Article, { type TocEntry } from '../../layouts/Article.astro';
import { plainText, summaryOf } from '../../lib/markdown';

export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'research'> };
const { Content, remarkPluginFrontmatter } = await render(entry);
const toc = (remarkPluginFrontmatter?.toc ?? []) as TocEntry[];
---

<Article
  title={entry.data.title}
  description={plainText(summaryOf(entry))}
  crumb={{ label: 'Research', href: '/#research' }}
  repo={entry.data.repo}
  toc={toc}
>
  <Content />
</Article>
