---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const research = await getCollection('research', ({ data }) => !data.draft);
const writeups = await getCollection('writeups', ({ data }) => !data.draft);
const path = Astro.url.pathname;

const items = [
  ...(research.length > 0
    ? [
        {
          label: 'Research',
          href: research.length === 1 ? `/research/${research[0].id}/` : '/#research',
          current: path.startsWith('/research/'),
        },
      ]
    : []),
  ...(writeups.length > 0
    ? [{ label: 'Writeups', href: '/writeups/', current: path.startsWith('/writeups/') }]
    : []),
  { label: 'About', href: '/#about', current: false },
  { label: 'Contact', href: '/#contact', current: false },
  ...(site.resume ? [{ label: 'Résumé', href: site.resume, current: false }] : []),
];
---

<header class="site-header">
  <div class="wrap row">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Primary">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.github} rel="me">GitHub</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.125rem;
  }
  .wordmark {
    font-size: 1.1875rem;
    font-weight: 560;
    letter-spacing: 0.005em;
    text-decoration: none;
    color: var(--color-ink);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
    font-size: var(--fs-sm);
  }
  @media (min-width: 40rem) {
    ul {
      gap: 0.25rem 1.5rem;
    }
  }
  nav a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  nav a:hover {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-amber);
  }
</style>
