---
/**
 * One résumé section, typeset. Text comes from src/data/resume.ts unchanged.
 * - Sections where every line is "Label: details" render as a two-column list.
 * - Entries ("name<TAB>date" in the résumé) show the date on the right.
 * - A bullet that opens with a short "Label:" shows the label emphasized, as the
 *   résumé sets it in bold. The text itself is unchanged.
 * - `links` turns an exact phrase at the start of a line into a link.
 */
import type { ResumeSection } from '../data/resume';

interface Props {
  section: ResumeSection;
  links?: Record<string, string>;
}

const { section, links = {} } = Astro.props;
const items = section.items;

const pairOf = (text = '') => {
  const i = text.indexOf(': ');
  if (i <= 0 || i > 32) return null;
  const label = text.slice(0, i);
  return label.includes('.') ? null : { label, rest: text.slice(i + 2) };
};
const asPairs = items.length > 1 && items.every((it) => it.kind === 'bullet' && pairOf(it.text));

/** "Label:" at the start of a bullet, including the colon, and the rest of the line. */
const leadOf = (text = '') => {
  const i = text.indexOf(': ');
  if (i <= 0 || i > 48 || text.slice(0, i).includes('. ')) return null;
  return { label: text.slice(0, i + 1), rest: text.slice(i + 1) };
};

/** Split a line into [linked phrase, remainder] when it starts with a known phrase. */
const linked = (text = '') => {
  for (const [phrase, href] of Object.entries(links)) {
    if (text.startsWith(phrase)) return { phrase, href, rest: text.slice(phrase.length) };
  }
  return null;
};

type Group = { kind: 'bullets'; items: string[] } | { kind: 'entry' | 'line'; item: (typeof items)[number] };
const groups: Group[] = [];
for (const it of items) {
  if (it.kind === 'bullet') {
    const last = groups.at(-1);
    if (last?.kind === 'bullets') last.items.push(it.text ?? '');
    else groups.push({ kind: 'bullets', items: [it.text ?? ''] });
  } else {
    groups.push({ kind: it.kind, item: it });
  }
}
---

{
  asPairs ? (
    <dl class="pairs">
      {items.map((it) => {
        const p = pairOf(it.text)!;
        return (
          <div>
            <dt>{p.label}</dt>
            <dd>{p.rest}</dd>
          </div>
        );
      })}
    </dl>
  ) : (
    <div class="items">
      {groups.map((g) =>
        g.kind === 'bullets' ? (
          <ul class="bullets">
            {g.items.map((text) => {
              const l = linked(text);
              const lead = l ? null : leadOf(text);
              return (
                <li>
                  {l ? (
                    <Fragment><a href={l.href}>{l.phrase}</a>{l.rest}</Fragment>
                  ) : lead ? (
                    <Fragment><span class="lead">{lead.label}</span>{lead.rest}</Fragment>
                  ) : (
                    text
                  )}
                </li>
              );
            })}
          </ul>
        ) : g.kind === 'entry' ? (
          <div class="entry">
            <div class="entry-head">
              <p class="entry-name">{g.item.name}</p>
              {g.item.date && <p class="entry-date">{g.item.date}</p>}
            </div>
            {g.item.lines?.map((line) => <p class="entry-line">{line}</p>)}
            {g.item.bullets && g.item.bullets.length > 0 && (
              <ul class="bullets">
                {g.item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <p class="line">{g.item.text}</p>
        ),
      )}
    </div>
  )
}

<style>
  .items {
    display: grid;
    gap: 0;
    max-width: 46rem;
    border-top: 1px solid var(--color-rule);
  }
  .items > * {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .items > .bullets {
    padding-block: 0;
  }

  .bullets {
    display: grid;
  }
  .items > .bullets > li {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .items > .bullets > li:last-child {
    border-bottom: 0;
  }
  .bullets > li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink);
  }
  .bullets > li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: calc(0.875rem + 0.8em - 0.15rem);
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-ink-3);
  }
  .bullets > li:has(.lead) {
    color: var(--color-ink-2);
  }
  .lead {
    color: var(--color-ink);
    font-weight: 600;
  }
  .entry .bullets {
    margin-top: 0.5rem;
    gap: 0.375rem;
  }
  .entry .bullets > li {
    color: var(--color-ink-2);
  }
  .entry .bullets > li::before {
    top: 0.8em;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.125rem 1.5rem;
  }
  .entry-name {
    font-weight: 500;
    color: var(--color-ink);
    min-width: 0;
  }
  .entry-date {
    font-size: var(--fs-sm);
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .entry-line {
    color: var(--color-ink-2);
    margin-top: 0.25rem;
  }
  .line {
    color: var(--color-ink);
  }

  .pairs {
    max-width: 46rem;
    border-top: 1px solid var(--color-rule);
  }
  .pairs div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 48rem) {
    .pairs div {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .pairs dt {
    font-weight: 500;
    color: var(--color-ink);
  }
  .pairs dd {
    color: var(--color-ink-2);
    max-width: 62ch;
  }
</style>
